# MongoDB Connection URI (Atlas cluster or local)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/sehatsure?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:NEW_PASSWORD@cluster.example.mongodb.net/nextcare

# Google Gemini API Key for policy document extraction
GEMINI_API_KEY=your-google-cloud-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Web Server Port (Render sets this automatically)
PORT=5000

# Client origin for CORS (Render app URL or local dev)
CLIENT_URL=http://localhost:5173

# Optional: Google Places API Key
GOOGLE_PLACES_API_KEY=

# Optional: Spline 3D scene for the landing page hero (put in frontend/.env locally,
# or as an environment variable on Render). Leave empty to use the built-in scene.
VITE_SPLINE_SCENE_URL=
